# ─── Bengal International University — Backend environment ───
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Runtime
NODE_ENV=development
PORT=3000

# Auth — REQUIRED in production. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biu_portal
# Set to true for managed cloud databases that require SSL
DB_SSL=false

# Cookies
# For a same-origin deploy (this server serves the frontend) leave the defaults.
# For a cross-site deploy (frontend on a different domain) use:
#   COOKIE_SAMESITE=none  and  COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# CORS — comma-separated extra origins (only needed for cross-site frontends)
# CORS_ORIGINS=https://your-frontend.vercel.app

# Default password assigned to seeded accounts
DEFAULT_PASSWORD=123456
